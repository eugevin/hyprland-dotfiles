// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "margin-left": 16,
    "margin-right": 16,
    "modules-left": [
	    "hyprland/workspaces",
	    "mpris"
    ],
    "modules-center": [
	    "clock"
    ],
    "modules-right": [
	    "hyprland/language",
	    "wireplumber",
	    "cpu",
	    "memory",
	    "network",
	    "tray"
    ],
    "hyprland/workspaces": {
	    "persistent-workspaces": {
		    "*": 5 
	    }
    },
    "mpris": {
	    "interval": 1,
	    "format": "{artist} - {title} [{position}/{length}]",
	    "format-paused": "<i>{artist} - {title} [{position}/{length}]</i>",
	    "dynamic-len": 35,
	    "status-icons": {
		    "paused": "   "
	    },
	    "on-click": "playerctl play-pause"
    },
    "hyprland/language": {
	    "format": "{}",
    	    "format-en": "us",
    	    "format-ru": "ru"
    },
    "clock": {
	    "format": "{:%m.%d | %H:%M}"
    },
    "wireplumber": {
	    "scroll-step": 5,
	    "format": "  {volume}%",
	    "format-muted": "  Mute",
	    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
	    "on-click-right": "pavucontrol"
    },
    "cpu": {
	    "interval": 10,
	    "format": "  {usage}%"
    },
    "memory": {
	    "interval": 10,
	    "format": "  {used:0.1f}G/{total:0.1f}G"
    },
    "network": {
	    "interval": 5,
	    "format-wifi": "  {essid}",
	    "format-ethernet": "  {ifname}",
	    "format-disconnected": "󰌙  No connection"
    },
    "tray": {
	    "icon-size": 16,
	    "spacing": 8
    }
}
