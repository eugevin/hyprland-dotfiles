configuration {
    modi:                       "drun";
    show-icons:                 true;
    drun-display-format:        "{name}";
    font:                       "Iosevka Nerd Font Medium 15";
}

/* Same tokens as quickshell/shared.js */
* {
    bg:          #292C3D;
    bg-active:   #E59B5C;
    track:       #49454B;
    text:        #FED49B;
    text-white:  #FBF7F0;
    text-dim:    #A99175;

    background-color:            transparent;
    text-color:                  @text;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    border-radius:               10px;
    background-color:            @bg;
    padding:                     10px;
    cursor:                      "default";
}

mainbox {
    spacing:                     10px;
    children:                    [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:                     12px;
    padding:                     10px 14px;
    border-radius:               10px;
    background-color:            @track;
    children:                    [ "textbox-prompt", "entry" ];
}

textbox-prompt {
    expand:                      false;
    font:                        "Iosevka Nerd Font Propo 15";
    str:                         "";
    text-color:                  @bg-active;
    vertical-align:              0.5;
}

entry {
    text-color:                  @text-white;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @text-dim;
    vertical-align:              0.5;
}

message {
    padding:                     8px 14px;
    border-radius:               10px;
    background-color:            @track;
}

textbox {
    text-color:                  @text-white;
}

listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   false;
    fixed-height:                true;
    spacing:                     4px;
}

element {
    spacing:                     12px;
    padding:                     8px 14px;
    border-radius:               10px;
    text-color:                  @text;
    cursor:                      pointer;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:            @bg-active;
    text-color:                  @text-white;
}

element-icon {
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    text-color:                  inherit;
    highlight:                   underline;
    cursor:                      inherit;
    vertical-align:              0.5;
}
